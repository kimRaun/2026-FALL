    const scenes=[
      {start:0,end:30,title:"오프닝 — 문제 제기",description:"스마트폰에 뉴스 알림이 쏟아지고 기사 제목이 빠르게 지나갑니다. ‘속보’, ‘단독’, ‘논란’, ‘파장’이 화면을 채웁니다.",narration:"우리는 매일 수많은 뉴스를 봅니다. 하지만 뉴스가 많아질수록, 정작 중요한 이슈는 더 빨리 놓치게 됩니다.",caption:"뉴스는 많다\n하지만 핵심은 보이지 않는다"},
      {start:30,end:60,title:"문제 1 — 이슈를 빨리 파악하기 어렵다",description:"여러 플랫폼에 기사가 업로드되고 지친 스크롤이 이어집니다. ‘지금 정말 중요한 이슈가 뭘까?’라는 질문이 나타납니다.",narration:"정보는 넘쳐나지만, 무엇이 지금 집중해서 봐야 할 이슈인지 파악하기는 쉽지 않습니다. 이슈를 놓치면, 이미 여론은 한참 앞서가 있습니다.",caption:"지금 정말 중요한 이슈가 뭘까?"},
      {start:60,end:95,title:"문제 2 — 반복 뉴스의 홍수",description:"비슷한 기사 카드가 복제되듯 늘어나고 같은 문장이 형광펜처럼 반복 강조됩니다.",narration:"또 다른 문제는 반복 보도입니다. 서로 다른 언론사 기사처럼 보이지만, 실제로는 비슷한 문장과 구조를 반복하는 경우가 많습니다. 독자는 새로운 정보인지, 단순한 재가공인지 구분하기 어렵습니다.",caption:"같은 말의 반복\n새 정보는 적고, 피로도는 높다"},
      {start:95,end:130,title:"문제 3 — 언론사마다 다른 프레임",description:"동일 이슈를 A언론 ‘정부 강행’, B언론 ‘개혁 추진’, C언론 ‘정치권 충돌’이라는 분할 헤드라인으로 비교합니다.",narration:"같은 사건도 언론사에 따라 다르게 보입니다. 어떤 언론은 갈등을 강조하고, 어떤 언론은 성과를 강조합니다. 독자는 사실보다 프레임을 먼저 접할 수 있습니다.",caption:"같은 사건\n다른 표현\n다른 인상"},
      {start:130,end:160,title:"해결책 제시 — 프레임체크 소개",description:"프레임체크 로고와 UI 목업이 등장합니다. 이슈 알림, 기사 비교, 복붙률 분석을 차례로 보여주고 핵심 차별점을 크게 강조합니다.",narration:"그래서 제안하는 서비스가 바로 프레임체크입니다. 프레임체크는 사용자가 설정한 키워드를 중심으로 여러 언론사의 반복 보도 횟수, 표현 차이, 기사 유사도를 비교해 보여주는 AI 뉴스 분석 플랫폼입니다.",caption:"뉴스를 요약하는 서비스가 아니라,\n뉴스들 사이의 차이를 분석하는 서비스"},
      {start:160,end:190,title:"기능 1 — 키워드 이슈 알림",description:"‘반도체’, ‘부동산’, ‘총선’, ‘의대 정원’ 키워드가 입력되고 ‘3회 이상 언급’, ‘10회 이상 확산’ 알림창이 순서대로 나타납니다.",narration:"사용자는 관심 키워드를 설정할 수 있습니다. 그리고 해당 키워드가 일정 횟수 이상 반복 보도되면, 이슈 발생 단계와 확산 단계를 알림으로 받아볼 수 있습니다.",caption:"관심 키워드 설정\n이슈 발생 → 확산 단계 알림"},
      {start:190,end:225,title:"기능 2 — 언론사별 비교 보기",description:"여러 언론사의 헤드라인과 핵심 문장을 한 화면에서 비교합니다. 제목, 핵심 키워드, 강조 포인트의 차이를 표시합니다.",narration:"또한 같은 이슈를 다룬 여러 언론사의 보도를 한 화면에서 비교할 수 있습니다. 제목이 어떻게 다른지, 어떤 사실을 먼저 배치했는지, 어떤 단어로 사건을 해석했는지 직관적으로 확인할 수 있습니다.",caption:"제목 차이 · 핵심 키워드 차이 · 강조 포인트 차이"},
      {start:225,end:260,title:"기능 3 — AI 복붙률·유사도 분석",description:"유사도 게이지가 상승하고 반복 문장이 강조됩니다. 유사 표현 비율, 반복 문장, 새로운 정보 포함 기사 지표를 보여줍니다. 화면의 수치는 시각 연출용 예시입니다.",narration:"AI는 기사 간 문장 유사도와 반복 표현도 분석합니다. 이를 통해 단순 반복 보도와 실제로 새로운 정보가 담긴 보도를 구분해 보여줍니다. 뉴스를 더 많이 보는 것이 아니라, 더 잘 보게 만드는 기능입니다.",caption:"더 많이 보는 것이 아니라, 더 잘 보기"},
      {start:260,end:290,title:"주요 고객과 시장",description:"대학생, 취준생, 일반 독자, 기자·연구자, 기관·기업을 아이콘과 카드로 분류합니다.",narration:"프레임체크의 주요 고객은 시사 이슈를 빠르게 파악해야 하는 대학생과 취업 준비생, 뉴스를 비판적으로 읽고 싶은 일반 독자입니다. 더 나아가 언론 모니터링이 필요한 공공기관, 기업, 교육기관에도 활용될 수 있습니다.",caption:"개인에서 기관까지, 더 명확한 뉴스 읽기"},
      {start:290,end:320,title:"수익 구조",description:"개인 구독, 기관용 대시보드, 교육용 라이선스, 리포트/API의 네 갈래 수익 구조를 도식화합니다.",narration:"수익 구조는 개인 대상 구독 모델, 기관용 대시보드 제공, 교육기관 라이선스, 이슈 분석 리포트 판매로 구성됩니다. 초기에는 개인 사용자 기반을 확보하고, 이후 공공기관과 교육기관으로 확장할 수 있습니다.",caption:"개인 구독 → 기관·교육 확장"},
      {start:320,end:350,title:"기대 효과",description:"개인의 ‘핵심 파악’, 사회의 ‘미디어 리터러시 강화’, 공공의 ‘정책 소통 개선’을 세 갈래 카드로 보여줍니다.",narration:"이 서비스는 개인에게는 핵심 이슈를 더 빠르게 이해하게 하고, 사회적으로는 미디어 리터러시를 높이며, 정부와 공공기관에는 언론 반응을 더 정교하게 분석할 수 있는 도구가 될 수 있습니다.",caption:"개인 · 사회 · 공공을 위한 변화"},
      {start:350,end:370,title:"클로징",description:"복잡한 뉴스 화면이 정리된 비교 대시보드로 전환되며 브랜드 메시지로 마무리합니다.",narration:"뉴스가 넘치는 시대, 필요한 것은 더 많은 뉴스가 아니라 더 나은 뉴스 읽기입니다. 프레임체크는 정보의 양이 아니라 정보의 구조를 보여주는 서비스입니다.",caption:"프레임체크\n뉴스를 보는 눈을, 한 단계 더."}
    ];
    const $=id=>document.getElementById(id);
    const cards=[...document.querySelectorAll('.scene-item')];
    const panels=[...document.querySelectorAll('.scene')];
    let time=0,playing=false,lastTick=0,current=-1,frame=0;
    const fmt=s=>`${String(Math.floor(s/60)).padStart(2,'0')}:${String(Math.floor(s%60)).padStart(2,'0')}`;
    function show(t, restart=false){
      time=Math.max(0,Math.min(370,t));
      const index=time===370?11:scenes.findIndex(s=>time>=s.start&&time<s.end);
      if(index!==current||restart){
        current=index;
        cards.forEach((el,i)=>{el.classList.toggle('active',i===index);el.setAttribute('aria-current',i===index?'true':'false')});
        panels.forEach((el,i)=>el.classList.toggle('active',i===index));
        const v=$('visual');v.classList.remove('motion');void v.offsetWidth;v.classList.add('motion');
        $('stage-title').textContent=scenes[index].title;
        $('description').textContent=scenes[index].description;
        $('narration').textContent=scenes[index].narration;
        $('caption').textContent=scenes[index].caption;
        $('scene-time').textContent=`${fmt(scenes[index].start)} — ${fmt(scenes[index].end)}`;
        $('stage-number').textContent=`SCENE ${String(index+1).padStart(2,'0')} / 12`;
        $('scene-counter').textContent=`${String(index+1).padStart(2,'0')} / 12`;
      }
      $('timeline').value=String(time);
      $('clock').textContent=`${fmt(time)} / 06:10`;
      $('scene-progress').style.width=`${Math.min(100,(time-scenes[index].start)/(scenes[index].end-scenes[index].start)*100)}%`;
      $('timeline').style.background=`linear-gradient(to right,#65e4c5 ${time/370*100}%,#315064 ${time/370*100}%)`;
    }
    function setPlaying(value){
      playing=value;
      $('play-label').hidden=value;$('pause-label').hidden=!value;
      $('play').setAttribute('aria-label',value?'일시정지':'재생');
      if(value){lastTick=performance.now();frame=requestAnimationFrame(tick)}else cancelAnimationFrame(frame);
    }
    function tick(now){
      if(!playing)return;
      const elapsed=Math.min((now-lastTick)/1000,.25);lastTick=now;
      show(time+elapsed);
      if(time>=370){setPlaying(false);return}
      frame=requestAnimationFrame(tick);
    }
    $('play').addEventListener('click',()=>{if(!playing&&time>=370)show(0,true);setPlaying(!playing)});
    $('prev').addEventListener('click',()=>show(scenes[Math.max(0,current-1)].start,true));
    $('next').addEventListener('click',()=>show(scenes[Math.min(11,current+1)].start,true));
    $('timeline').addEventListener('input',e=>show(Number(e.target.value),true));
    cards.forEach((card,i)=>card.addEventListener('click',()=>show(scenes[i].start,true)));
    show(0);
  </script>
 
</body></html>
